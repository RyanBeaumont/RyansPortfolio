<nav class="navbar navbar-expand-lg navbar-light bg-light">
  <a class="navbar-brand" href="#">
    <%= image_tag("Logo.JPG",alt: 'Portfolio Homepage') %>
  </a>
  <div class="collapse navbar-collapse" id="navbarNav">
    <ul class="navbar-nav">
      <li class="nav-item active">
        <a class="nav-link" href="#">Home </a>
      </li>
      <li class="nav-item">
        <a class="nav-link" href="#">Students</a>
      </li>
    </ul>
  </div>
</nav>

<p style="color: green"><%= notice %></p>


<h1>Search By Student</h1>

<nav aria-label=’Search For Students’>
<%=render 'search_form',search_params: @search_params %>
</nav>
<% if @search_params.present? || params[:show_all] == "true" %>
<nav aria-label=’Search Results’>
<table class="table table-striped mb-20">
  <thead class="thead_dark">
    <tr>
      <th scope="col">Profile</th>
      <th scope="col">First Name</th>
      <th scope="col">Last Name</th>
      <th scope="col">Major</th>
      <th scope="col">Graduation Date</th>
      <th scope="col">Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @students.each do |student| %>
      <tr>
        <td>
        <% if student.avatar.attached? %>
          <%= image_tag(student.avatar ,style: "max-width: 40px;") %>
        <% else %>
          <%= image_tag "DefaultStudent.png", style: "max-width: 40px;" %>
        <% end %>
        </td>
        <td><%= student.first_name %></td>
        <td><%= student.last_name %></td>
        <td><%= student.major %></td>
        <td><%= student.graduation_date %></td>
        <td>
          <%= link_to "View", student, class: "btn btn-primary d-inline-block mr-1" %>
          <%= link_to "Edit", edit_student_path(student), class: "btn btn-warning d-inline-block mr-1" %>
          <%= form_with(model: student, method: :delete, local: true, class: "d-inline-block") do %>
            <%= submit_tag "Delete", class: "btn btn-outline-danger" %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
</nav>
<%end%>

<%= link_to "+ New student", new_student_path, class: "btn btn-outline-success btn-sm" %>


